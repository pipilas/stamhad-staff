#!/bin/bash
# Give the app to the person who installed it (the installer makes it root's),
# so NUME can update itself later without a password.
APP="/Applications/NUME.app"
OLD="/Applications/Stamhad Staff.app"          # same app before the rename
if [ -d "$OLD" ] && [ "$(defaults read "$OLD/Contents/Info" CFBundleIdentifier 2>/dev/null)" = "com.stamhad.staff" ]; then
  rm -rf "$OLD"
fi
U=$(stat -f %Su /dev/console 2>/dev/null)
if [ -n "$U" ] && [ "$U" != "root" ] && [ -d "$APP" ]; then
  chown -R "$U":staff "$APP"
fi
xattr -dr com.apple.quarantine "$APP" 2>/dev/null
exit 0
